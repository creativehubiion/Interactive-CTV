<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEST-ONLY two-ad pod: poll (sequence 1) + game (sequence 2), replicating
  FT's SpringServe pod that served both SIMID creatives together. Used to test
  whether the two-ad pod is what breaks D-pad input reaching the creative.
  Remove after testing.
-->
<VAST xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vast.xsd" version="3.0">
  <Ad id="interactive-ctv-poll-1" sequence="1">
    <InLine>
      <AdSystem>interactive-ctv-ref</AdSystem>
      <AdTitle>Interactive CTV Poll — Rate Your Support</AdTitle>
      <Description>D-pad-driven SIMID interactive poll over a linear video.</Description>
      <Error>https://creativehubiion.github.io/Interactive-CTV/track/error</Error>
      <Impression>https://creativehubiion.github.io/Interactive-CTV/track/impression</Impression>
      <Creatives>
        <Creative sequence="1">
          <Linear>
            <Duration>00:00:30</Duration>
            <TrackingEvents>
              <Tracking event="start">https://creativehubiion.github.io/Interactive-CTV/track/start</Tracking>
              <Tracking event="firstQuartile">https://creativehubiion.github.io/Interactive-CTV/track/q1</Tracking>
              <Tracking event="midpoint">https://creativehubiion.github.io/Interactive-CTV/track/q2</Tracking>
              <Tracking event="thirdQuartile">https://creativehubiion.github.io/Interactive-CTV/track/q3</Tracking>
              <Tracking event="complete">https://creativehubiion.github.io/Interactive-CTV/track/complete</Tracking>
              <Tracking event="creativeView">https://creativehubiion.github.io/Interactive-CTV/track/creativeView</Tracking>
              <Tracking event="skip">https://creativehubiion.github.io/Interactive-CTV/track/skip</Tracking>
              <Tracking event="select">https://creativehubiion.github.io/Interactive-CTV/track/select</Tracking>
              <Tracking event="timeout">https://creativehubiion.github.io/Interactive-CTV/track/timeout</Tracking>
            </TrackingEvents>
            <VideoClicks>
              <ClickThrough id="ctv-poll-1">https://creativehubiion.github.io/Interactive-CTV/</ClickThrough>
              <ClickTracking id="ctv-poll-1">https://creativehubiion.github.io/Interactive-CTV/track/click</ClickTracking>
            </VideoClicks>
            <MediaFiles>
              <MediaFile delivery="progressive" type="video/mp4" width="1280" height="720">
                https://creativehubiion.github.io/Interactive-CTV/creative/poll/assets/video.mp4
              </MediaFile>
              <InteractiveCreativeFile type="text/html" apiFramework="SIMID" variableDuration="true">
                https://creativehubiion.github.io/Interactive-CTV/creative/poll/index.html?v=9
              </InteractiveCreativeFile>
            </MediaFiles>
          </Linear>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
  <Ad id="interactive-ctv-demo-1" sequence="2">
    <InLine>
      <AdSystem>interactive-ctv-ref</AdSystem>
      <AdTitle>Interactive CTV Demo — Pick Your Vibe</AdTitle>
      <Description>D-pad-driven SIMID interactive overlay over a linear video.</Description>
      <Error>https://creativehubiion.github.io/Interactive-CTV/track/error</Error>
      <Impression>https://creativehubiion.github.io/Interactive-CTV/track/impression</Impression>
      <Creatives>
        <Creative sequence="1">
          <Linear>
            <Duration>00:00:30</Duration>
            <TrackingEvents>
              <Tracking event="start">https://creativehubiion.github.io/Interactive-CTV/track/start</Tracking>
              <Tracking event="firstQuartile">https://creativehubiion.github.io/Interactive-CTV/track/q1</Tracking>
              <Tracking event="midpoint">https://creativehubiion.github.io/Interactive-CTV/track/q2</Tracking>
              <Tracking event="thirdQuartile">https://creativehubiion.github.io/Interactive-CTV/track/q3</Tracking>
              <Tracking event="complete">https://creativehubiion.github.io/Interactive-CTV/track/complete</Tracking>
              <Tracking event="creativeView">https://creativehubiion.github.io/Interactive-CTV/track/creativeView</Tracking>
              <Tracking event="skip">https://creativehubiion.github.io/Interactive-CTV/track/skip</Tracking>
              <Tracking event="select">https://creativehubiion.github.io/Interactive-CTV/track/select</Tracking>
              <Tracking event="timeout">https://creativehubiion.github.io/Interactive-CTV/track/timeout</Tracking>
            </TrackingEvents>
            <VideoClicks>
              <ClickThrough id="ctv-1">https://creativehubiion.github.io/Interactive-CTV/</ClickThrough>
              <ClickTracking id="ctv-1">https://creativehubiion.github.io/Interactive-CTV/track/click</ClickTracking>
            </VideoClicks>
            <MediaFiles>
              <MediaFile delivery="progressive" type="video/mp4">
                https://storage.googleapis.com/interactive-media-ads/media/android.mp4
              </MediaFile>
              <InteractiveCreativeFile type="text/html" apiFramework="SIMID" variableDuration="true">
                https://creativehubiion.github.io/Interactive-CTV/creative/index.html?v=11
              </InteractiveCreativeFile>
            </MediaFiles>
          </Linear>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
</VAST>
